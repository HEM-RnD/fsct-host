[Unit]
Description=FSCT driver
Requires=fsct-driver.socket
After=fsct-driver.socket network.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/fsctd --driver
Restart=on-failure
RestartSec=1s
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
# Resource limits and accounting
LimitNOFILE=4096
TasksMax=256
MemoryAccounting=true
MemoryMax=1G
#CPUAccounting=true
#CPUQuota=80%

[Install]
WantedBy=multi-user.target
