#!/bin/sh
set -e

# On purge, remove leftover files
if [ "$1" = "purge" ]; then
  :
fi

# Reload systemd for all scopes
if command -v systemctl >/dev/null; then
  # System-wide reload
  systemctl daemon-reload || true

  # Reload user systemd instances for all currently logged-in users
  if command -v loginctl >/dev/null; then
    for u in $(loginctl list-users --no-legend | awk '{print $1}'); do
      su -s /bin/sh -c "systemctl --user daemon-reload || true" "$u" 2>/dev/null || true
    done
  fi

  # Reload the global user unit directory cache as well
  systemctl --global daemon-reload || true
fi

exit 0
