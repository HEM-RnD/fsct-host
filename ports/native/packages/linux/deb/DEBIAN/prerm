#!/bin/sh
set -e

if command -v systemctl >/dev/null; then
    # Stop and disable system service first
    systemctl stop fsct-driver.service || true
    systemctl disable fsct-driver.service || true

    systemctl stop fsct.socket || true
    systemctl disable fsct.socket || true

    # Disable global user unit so it won't auto-enable for new users
    systemctl --global disable fsct-mpris.service || true

    # Attempt to stop user services for logged-in users
    if command -v loginctl >/dev/null; then
        for u in $(loginctl list-users --no-legend | awk '{print $1}'); do
            su -s /bin/sh -c "systemctl --user disable --now fsct-mpris.service || true; systemctl --user disable --now fsct-user.service || true" "$u" 2>/dev/null || true
        done
    fi
fi

exit 0
