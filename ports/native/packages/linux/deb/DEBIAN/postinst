#!/bin/sh
set -e

# Create fsct group if missing
if ! getent group fsct >/dev/null; then
    addgroup --system fsct 2>/dev/null || groupadd --system fsct || true
fi

# Reload systemd
if command -v systemctl >/dev/null; then
    systemctl daemon-reload || true
    systemctl enable fsct.socket || true
    systemctl enable fsct.service || true
    systemctl start fsct.socket || true
    systemctl restart fsct.service || true

    # Install/enable user unit globally so new users get it by default
    systemctl --global enable fsct-user.service || true

    # Try to start per-user service for currently logged-in users
    if command -v loginctl >/dev/null; then
        for u in $(loginctl list-users --no-legend | awk '{print $1}'); do
            su -s /bin/sh -c "systemctl --user daemon-reload; systemctl --user enable --now fsct-user.service || true" "$u" 2>/dev/null || true
        done
    fi
fi

exit 0
