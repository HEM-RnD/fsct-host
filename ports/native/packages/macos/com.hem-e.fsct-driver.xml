<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>com.hem-e.fsct-driver</string>
        <key>ProgramArguments</key>
        <array>
            <string>/usr/local/bin/fsctd</string>
            <string>--driver</string>
        </array>
        <key>RunAtLoad</key>
        <true/>
        <key>KeepAlive</key>
        <dict>
            <key>SuccessfulExit</key>
            <false/>
        </dict>
        <key>Sockets</key>
        <dict>
            <key>Listener</key>
            <dict>
                <key>SockPathName</key>
                <string>/var/run/fsct/fsct.sock</string>
                <key>SockPathMode</key>
                <integer>438</integer>
            </dict>
        </dict>
        <key>StandardOutPath</key>
        <string>/tmp/fsct_driver_service.log</string>
        <key>StandardErrorPath</key>
        <string>/tmp/fsct_driver_service.err</string>
    </dict>
</plist>