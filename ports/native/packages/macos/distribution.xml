<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Ferrum Streaming Control Technology™ Driver</title>
    <organization>com.hem-e</organization>
    <domains enable_localSystem="true"/>
    <options customize="never" require-scripts="true" rootVolumeOnly="true"/>
    <license file="EULA.rtf"/>
    <script>
        <postinstall file="./postinstall"/>
    </script>
    <pkg-ref id="com.hem-e.fsct-driver.bin"/>
    <pkg-ref id="com.hem-e.fsct-driver.daemon"/>
    <choices-outline>
        <line choice="default">
            <line choice="bin"/>
            <line choice="daemon"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="bin" visible="false">
        <pkg-ref id="com.hem-e.fsct-driver.bin"/>
    </choice>
    <choice id="daemon" visible="false">
        <pkg-ref id="com.hem-e.fsct-driver.daemon"/>
    </choice>
    <pkg-ref id="com.hem-e.fsct-driver.bin" version="0.2.0" onConclusion="none">bin.pkg</pkg-ref>
    <pkg-ref id="com.hem-e.fsct-driver.daemon" version="0.2.0" onConclusion="none">daemon.pkg</pkg-ref>
</installer-gui-script>
